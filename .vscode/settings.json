{
    "editor.indentSize": "tabSize",
    "[nix]": {
        "editor.tabSize": 4
    },
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": "\\.nix$",
                "cmd": "python3 ${workspaceFolder}/nix/3-laptop/4-apps/tools/banner-lint.py ${file}"
            }
        ]
    },
    // Workspace settings replace the object from home-manager wholesale, so the formatting command is
    // repeated here; only the options blocks are new.
    "nix.serverSettings": {
        "nixd": {
            "formatting": {
                "command": [
                    "nixfmt",
                    "--indent",
                    "4"
                ]
            },
            "options": {
                "nixos": {
                    "expr": "(builtins.getFlake \"/Storage/Files/Projects/TechNet\").nixosConfigurations.Odin.options"
                },
                "home-manager": {
                    "expr": "(builtins.getFlake \"/Storage/Files/Projects/TechNet\").nixosConfigurations.Odin.options.home-manager.users.type.getSubOptions []"
                }
            }
        }
    },
    "cSpell.words": [
        "arion",
        "dconf",
        "disko",
        "dockitem",
        "fastfetch",
        "gvariant",
        "libinput",
        "nemo",
        "neofetch",
        "nixos",
        "nixpkgs",
        "pkgs",
        "virt",
        "wamserma",
        "warpinator",
        "xsession"
    ],
    "conventionalCommits.scopes": [
        "Odin/Cinnamon",
        "Odin/VsCodium"
    ]
}