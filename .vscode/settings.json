{
    "editor.indentSize": "tabSize",
    "[nix]": {
        "editor.tabSize": 4
    },
    "emeraldwalk.runonsave": {
        "commands": [
            {
                "match": "\\.nix$",
                "cmd": "python3 ${workspaceFolder}/nix/3-laptop/4-apps/tools/banner-lint.py ${file}"
            }
        ]
    },
    "cSpell.words": [
        "arion",
        "dconf",
        "disko",
        "dockitem",
        "fastfetch",
        "gvariant",
        "libinput",
        "nemo",
        "neofetch",
        "nixos",
        "nixpkgs",
        "pkgs",
        "virt",
        "wamserma",
        "warpinator",
        "xsession"
    ]
}