{
    "manifest_version": 2,
    "name": "Bookmark Sorter",
    "version": "1.2",
    "description": "Sorts bookmarks in conversation with a local model, and applies bookmark-sorter plans.",
    "browser_specific_settings": {
        "gecko": {
            "id": "bookmark-sorter@technet.local",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "permissions": [
        "bookmarks",
        "http://127.0.0.1/*"
    ],
    "sidebar_action": {
        "default_title": "Bookmarks",
        "default_panel": "sidebar.html"
    },
    "browser_action": {
        "default_title": "Apply a bookmark plan",
        "default_popup": "popup.html"
    }
}
