+{
+    g_autoptr(GError) error = NULL;
+
+    MM_IFACE_MODEM_GET_IFACE (self)->load_unlock_required_finish (self, res, &error);
+    if (!error) {
+        mm_obj_msg (self, "SIM inserted, handle as SIM hot-swap");
+        mm_iface_modem_process_sim_event (self);
+    } else if (!g_error_matches (error, MM_MOBILE_EQUIPMENT_ERROR, MM_MOBILE_EQUIPMENT_ERROR_SIM_NOT_INSERTED))
+        mm_obj_dbg (self, "couldn't recheck for a SIM: %s", error->message);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
