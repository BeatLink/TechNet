+static gboolean
+phoc_title_is_hidden (const char *title)
+{
+  const char *hidden;
+  g_auto (GStrv) tokens = NULL;
+
+  if (title == NULL)
+    return FALSE;
+
+  hidden = g_getenv ("PHOC_HIDDEN_TITLES");
+  if (hidden == NULL || hidden[0] == '\0')
+    return FALSE;
+
+  tokens = g_strsplit (hidden, ":", -1);
+  for (guint i = 0; tokens[i] != NULL; i++) {
+    if (tokens[i][0] != '\0' && strstr (title, tokens[i]) != NULL)
+      return TRUE;
+  }
+
+  return FALSE;
+}
