--- a/src/render.c	2026-08-04 18:16:27.509539057 -0500
+++ b/src/render.c	2026-08-04 18:16:27.534539549 -0500
@@ -306,6 +306,10 @@
 static void
 render_view (PhocOutput *output, PhocView *view, PhocRenderContext *ctx)
 {
+  /* Do not render views the user asked to keep out of sight */
+  if (phoc_view_is_hidden (view))
+    return;
+
   /*  Do not render views fullscreened on other outputs */
   if (phoc_view_is_fullscreen (view) && phoc_view_get_fullscreen_output (view) != output)
     return;
diff -ru a/src/view.c b/src/view.c
--- a/src/view.c	2026-08-04 18:16:27.501538900 -0500
+++ b/src/view.c	2026-08-04 18:16:27.533539530 -0500
@@ -315,6 +315,49 @@
 }
 
 
+static gboolean
+phoc_title_is_hidden (const char *title)
+{
+  const char *hidden;
+  g_auto (GStrv) tokens = NULL;
+
+  if (title == NULL)
+    return FALSE;
+
+  hidden = g_getenv ("PHOC_HIDDEN_TITLES");
+  if (hidden == NULL || hidden[0] == '\0')
+    return FALSE;
+
+  tokens = g_strsplit (hidden, ":", -1);
+  for (guint i = 0; tokens[i] != NULL; i++) {
+    if (tokens[i][0] != '\0' && strstr (title, tokens[i]) != NULL)
+      return TRUE;
+  }
+
+  return FALSE;
+}
+
+/**
+ * phoc_view_is_hidden:
+ * @self: The view
+ *
+ * Whether this view is one the user asked to keep out of sight entirely: not
+ * listed to the shell, and not drawn.
+ *
+ * Returns: %TRUE if the view should be hidden
+ */
+gboolean
+phoc_view_is_hidden (PhocView *self)
+{
+  PhocViewPrivate *priv;
+
+  g_assert (PHOC_IS_VIEW (self));
+  priv = phoc_view_get_instance_private (self);
+
+  return phoc_title_is_hidden (priv->title);
+}
+
+
